<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EchoMusic · 微光任务栏歌词" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" Focusable="False" Width="360" Height="48">
  <Grid x:Name="Root" Margin="0" IsHitTestVisible="False" ClipToBounds="True">
    <StackPanel VerticalAlignment="Center" Margin="4,1">
      <Grid x:Name="PrimaryViewport" ClipToBounds="True">
      <TextBlock x:Name="Primary" Text="让每一句，留在此刻" FontFamily="Microsoft YaHei UI, Segoe UI"
                 HorizontalAlignment="Left" FontSize="16" FontWeight="Medium" Foreground="#F1F7F6" TextTrimming="None" TextWrapping="NoWrap">
        <TextBlock.RenderTransform><TranslateTransform x:Name="PrimaryShift"/></TextBlock.RenderTransform>
        <TextBlock.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.3"/></TextBlock.Effect>
      </TextBlock>
      <TextBlock x:Name="PrimaryPlayed" Text="{Binding Text, ElementName=Primary}" FontFamily="{Binding FontFamily, ElementName=Primary}"
                 FontSize="{Binding FontSize, ElementName=Primary}" FontWeight="{Binding FontWeight, ElementName=Primary}"
                 Width="{Binding Width, ElementName=Primary}" TextTrimming="{Binding TextTrimming, ElementName=Primary}"
                 RenderTransform="{Binding RenderTransform, ElementName=Primary}" HorizontalAlignment="Left" TextWrapping="NoWrap" Foreground="#85DCD0" Visibility="Collapsed">
        <TextBlock.Clip><RectangleGeometry x:Name="PrimaryMask" Rect="0,0,0,48"/></TextBlock.Clip>
      </TextBlock>
      </Grid>
      <Grid x:Name="SecondaryViewport" ClipToBounds="True" Visibility="Collapsed" Margin="0,1,0,0">
      <TextBlock x:Name="Secondary" Text="下一段旋律，正在靠近" FontFamily="Microsoft YaHei UI, Segoe UI"
                 HorizontalAlignment="Left" FontSize="12" Foreground="#B4C3C1" Visibility="Collapsed"
                 TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
        <TextBlock.RenderTransform><TranslateTransform x:Name="SecondaryShift"/></TextBlock.RenderTransform>
      </TextBlock>
      <TextBlock x:Name="SecondaryPlayed" Text="{Binding Text, ElementName=Secondary}" FontFamily="{Binding FontFamily, ElementName=Secondary}"
                 FontSize="{Binding FontSize, ElementName=Secondary}" Width="{Binding Width, ElementName=Secondary}"
                 TextTrimming="{Binding TextTrimming, ElementName=Secondary}" RenderTransform="{Binding RenderTransform, ElementName=Secondary}"
                 HorizontalAlignment="Left" TextWrapping="NoWrap" Foreground="#85DCD0" Visibility="Collapsed">
        <TextBlock.Clip><RectangleGeometry x:Name="SecondaryMask" Rect="0,0,0,48"/></TextBlock.Clip>
      </TextBlock>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
