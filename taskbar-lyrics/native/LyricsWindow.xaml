<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EchoMusic · 微光任务栏歌词" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        ShowActivated="False" Topmost="True" Focusable="False" Width="360" Height="48">
  <Window.Resources>
    <SolidColorBrush x:Key="PrimaryWaiting" Color="#F1F7F6"/>
    <SolidColorBrush x:Key="SecondaryWaiting" Color="#B4C3C1"/>
    <SolidColorBrush x:Key="PrimaryAccent" Color="#85DCD0"/>
    <SolidColorBrush x:Key="SecondaryAccent" Color="#85DCD0"/>
    <SolidColorBrush x:Key="NoticeBackground" Color="#CC282B30"/>
    <SolidColorBrush x:Key="NoticeTitleInk" Color="#F1F7F6"/>
    <SolidColorBrush x:Key="NoticeArtistInk" Color="#BFC5CA"/>
    <!-- 同一份字形使用硬边双色画刷，不叠加第二层文字。 -->
    <LinearGradientBrush x:Key="PrimaryProgress" MappingMode="Absolute" StartPoint="0,0" EndPoint="300,0">
      <GradientStop Offset="0" Color="{Binding Color, Source={StaticResource PrimaryAccent}}"/>
      <GradientStop Offset="0" Color="{Binding Color, Source={StaticResource PrimaryAccent}}"/>
      <GradientStop Offset="0" Color="{Binding Color, Source={StaticResource PrimaryWaiting}}"/>
      <GradientStop Offset="1" Color="{Binding Color, Source={StaticResource PrimaryWaiting}}"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SecondaryProgress" MappingMode="Absolute" StartPoint="0,0" EndPoint="300,0">
      <GradientStop Offset="0" Color="{Binding Color, Source={StaticResource SecondaryAccent}}"/>
      <GradientStop Offset="0" Color="{Binding Color, Source={StaticResource SecondaryAccent}}"/>
      <GradientStop Offset="0" Color="{Binding Color, Source={StaticResource SecondaryWaiting}}"/>
      <GradientStop Offset="1" Color="{Binding Color, Source={StaticResource SecondaryWaiting}}"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="ButtonHitBackground" Color="#01000000"/>
    <Style x:Key="ControlButton" TargetType="Button">
      <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="2,0"/><Setter Property="Padding" Value="7"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#F1F7F6"/>
      <Setter Property="Focusable" Value="False"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ToolTipService.IsEnabled" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <!-- 极低透明度底层保留整块点击区域，不受悬停、按下背景开关影响。 -->
        <Grid Background="{StaticResource ButtonHitBackground}">
          <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="15" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        </Grid>
        <ControlTemplate.Triggers>
          <!-- 按下状态优先，两种背景可分别关闭。 -->
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource ButtonHoverBackground}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource ButtonPressedBackground}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid x:Name="Root" Margin="0" ClipToBounds="True">
    <!-- 内容统一上下偏移，窗口继续贴合任务栏。 -->
    <Grid x:Name="TaskbarContent">
    <Grid.RenderTransform><TranslateTransform x:Name="VerticalShift"/></Grid.RenderTransform>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid x:Name="CoverHost" Width="36" Height="36" Margin="4,0,4,0" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
      <Grid x:Name="CoverVisual" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><RotateTransform x:Name="CoverRotation"/></Grid.RenderTransform>
        <Grid.Resources><RectangleGeometry x:Key="CoverRectangle" Rect="0,0,36,36" RadiusX="5" RadiusY="5"/><EllipseGeometry x:Key="CoverCircle" Center="18,18" RadiusX="18" RadiusY="18"/></Grid.Resources>
        <Grid x:Name="CoverLayers">
        <Border x:Name="CoverFallback"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#243C41" Offset="0"/><GradientStop Color="#528C82" Offset="1"/></LinearGradientBrush></Border.Background><Viewbox Width="17" Height="17"><Path Data="M9 5 V17 A3 3 0 1 1 7 14.17 V7 L19 4 V14 A3 3 0 1 1 17 11.17 V2 Z" Fill="#BFECE3"/></Viewbox></Border>
        <Image x:Name="CoverPrevious" Stretch="UniformToFill" Visibility="Collapsed"/>
        <Image x:Name="CoverImage" Stretch="UniformToFill" Visibility="Collapsed"/>
        </Grid>
      </Grid>
    </Grid>
    <Grid x:Name="LyricsHost" Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="LyricsText" VerticalAlignment="Center" Margin="4,1" IsHitTestVisible="False">
      <Grid x:Name="PrimaryViewport" ClipToBounds="True">
      <!-- 完整文字在独立布局中排版，固定视口只裁切滚动后的画面。 -->
      <Grid Width="{Binding Width, ElementName=Primary}" HorizontalAlignment="{Binding HorizontalAlignment, ElementName=Primary}">
      <TextBlock x:Name="Primary" Text="让每一句，留在此刻" FontFamily="Microsoft YaHei UI, Segoe UI"
                 HorizontalAlignment="Left" FontSize="16" FontWeight="Medium" Foreground="{StaticResource PrimaryWaiting}" TextTrimming="None" TextWrapping="NoWrap">
        <TextBlock.RenderTransform><TranslateTransform x:Name="PrimaryShift"/></TextBlock.RenderTransform>
        <TextBlock.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.3"/></TextBlock.Effect>
      </TextBlock>
      </Grid>
      </Grid>
      <Grid x:Name="SecondaryViewport" ClipToBounds="True" Visibility="Collapsed" Margin="0,1,0,0">
      <Grid Width="{Binding Width, ElementName=Secondary}" HorizontalAlignment="{Binding HorizontalAlignment, ElementName=Secondary}">
      <TextBlock x:Name="Secondary" Text="下一段旋律，正在靠近" FontFamily="Microsoft YaHei UI, Segoe UI"
                 HorizontalAlignment="Left" FontSize="12" Foreground="{StaticResource SecondaryWaiting}" Visibility="Collapsed"
                 TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
        <TextBlock.RenderTransform><TranslateTransform x:Name="SecondaryShift"/></TextBlock.RenderTransform>
      </TextBlock>
      </Grid>
      </Grid>
    </StackPanel>
    <!-- 封面悬停信息独立于歌词时钟，长文字只在溢出时滚动。 -->
    <StackPanel x:Name="SongInfo" Grid.RowSpan="2" Margin="4,1" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
      <Grid x:Name="SongTitleViewport" ClipToBounds="True"><Grid Width="{Binding Width, ElementName=SongTitle}" HorizontalAlignment="Left"><TextBlock x:Name="SongTitle" FontSize="14" FontWeight="Medium" TextWrapping="NoWrap" HorizontalAlignment="Left"><TextBlock.RenderTransform><TranslateTransform x:Name="SongTitleShift"/></TextBlock.RenderTransform></TextBlock></Grid></Grid>
      <Grid x:Name="SongArtistViewport" ClipToBounds="True" Margin="0,1,0,0"><Grid Width="{Binding Width, ElementName=SongArtist}" HorizontalAlignment="Left"><TextBlock x:Name="SongArtist" FontSize="11" TextWrapping="NoWrap" HorizontalAlignment="Left"><TextBlock.RenderTransform><TranslateTransform x:Name="SongArtistShift"/></TextBlock.RenderTransform></TextBlock></Grid></Grid>
    </StackPanel>
    <!-- 居中按文字定位，并保留固定按钮宽度。 -->
    <Grid x:Name="ControlsAnchor" HorizontalAlignment="Left" Margin="4,0,4,0">
    <Viewbox x:Name="ControlsViewport" Visibility="Collapsed" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0">
      <Border x:Name="ControlsSurface" Width="144" Height="34" CornerRadius="18" Background="#E0202831" Padding="4,2">
        <StackPanel Orientation="Horizontal">
          <Button x:Name="PreviousButton" Style="{StaticResource ControlButton}" AutomationProperties.Name="上一首"><Path Data="M5 5 H8 V19 H5 Z M20 5 V19 L9 12 Z" Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
          <Button x:Name="PlayButton" Style="{StaticResource ControlButton}" AutomationProperties.Name="播放"><Grid><Path x:Name="PlayGlyph" Data="M7 3 V21 L22 12 Z" Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/><Path x:Name="PauseGlyph" Data="M6 4 H10 V20 H6 Z M14 4 H18 V20 H14 Z" Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Visibility="Collapsed"/></Grid></Button>
          <Button x:Name="NextButton" Style="{StaticResource ControlButton}" AutomationProperties.Name="下一首"><Path Data="M16 5 H19 V19 H16 Z M4 5 V19 L15 12 Z" Width="15" Height="15" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
          <Button x:Name="FavoriteButton" Style="{StaticResource ControlButton}" AutomationProperties.Name="收藏"><Path x:Name="FavoriteGlyph" Data="M12 21 C7 17 2 13 2 8 A5 5 0 0 1 12 7 A5 5 0 0 1 22 8 C22 13 17 17 12 21 Z" Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Fill="Transparent"/></Button>
        </StackPanel>
      </Border>
    </Viewbox>
    <Viewbox x:Name="ProgressTimeViewport" Visibility="Collapsed" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0" IsHitTestVisible="False">
      <Border Width="144" Height="34"><TextBlock x:Name="ProgressTime" Text="00:00 / 00:00" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#F1F7F6"/></Border>
    </Viewbox>
    </Grid>
    <!-- 命中区域高度固定，加粗时不会引起悬停反复切换。 -->
    <Grid x:Name="ProgressHost" Grid.Row="1" Width="144" Height="12" HorizontalAlignment="Left" Margin="7,0,0,2" Visibility="Collapsed">
      <Grid x:Name="ProgressTrack" Background="Transparent" Cursor="Hand" ToolTipService.IsEnabled="False" AutomationProperties.Name="歌曲播放进度">
        <Border x:Name="ProgressBed" Height="3" CornerRadius="3" Background="#60888888" IsHitTestVisible="False"/>
        <Border x:Name="ProgressFill" Width="0" Height="3" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource PrimaryAccent}" IsHitTestVisible="False"/>
        <Ellipse x:Name="ProgressThumb" Width="8" Height="8" HorizontalAlignment="Left" Fill="{StaticResource PrimaryAccent}" Visibility="Collapsed" IsHitTestVisible="False"/>
      </Grid>
    </Grid>
    </Grid>
    </Grid>
    <!-- 浮层使用独立弹出区域，不压缩任务栏内的歌词和按钮。 -->
    <Popup x:Name="TrackNotice" Placement="Custom" PlacementTarget="{Binding ElementName=LyricsHost}" AllowsTransparency="True" StaysOpen="True" Focusable="False">
      <Border x:Name="TrackNoticeSurface" Width="280" CornerRadius="12" Padding="12,9" Background="{StaticResource NoticeBackground}" BorderThickness="1" SnapsToDevicePixels="True">
        <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#40FFFFFF" Offset="0"/><GradientStop Color="#18FFFFFF" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
        <StackPanel>
          <Grid x:Name="NoticeTitleViewport" ClipToBounds="True"><Grid Width="{Binding Width, ElementName=NoticeTitle}" HorizontalAlignment="{Binding HorizontalAlignment, ElementName=NoticeTitle}"><TextBlock x:Name="NoticeTitle" FontSize="13" FontWeight="Medium" Foreground="{StaticResource NoticeTitleInk}" TextWrapping="NoWrap" HorizontalAlignment="Left"><TextBlock.RenderTransform><TranslateTransform x:Name="NoticeTitleShift"/></TextBlock.RenderTransform></TextBlock></Grid></Grid>
          <Grid x:Name="NoticeArtistViewport" ClipToBounds="True" Margin="0,3,0,0"><Grid Width="{Binding Width, ElementName=NoticeArtist}" HorizontalAlignment="{Binding HorizontalAlignment, ElementName=NoticeArtist}"><TextBlock x:Name="NoticeArtist" FontSize="11" Foreground="{StaticResource NoticeArtistInk}" TextWrapping="NoWrap" HorizontalAlignment="Left"><TextBlock.RenderTransform><TranslateTransform x:Name="NoticeArtistShift"/></TextBlock.RenderTransform></TextBlock></Grid></Grid>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
